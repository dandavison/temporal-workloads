</body>
</html>
"""
    with open(path, "w") as file:
        file.write(document)


def panels(variants: list[Variant], stage: str) -> str:
    """One histogram per variant, on shared bin edges and a shared bar scale, over a single
    x-axis: a column is the same slice of time in every panel."""
    shown = [variant for variant in variants if collected(variant, stage)]
    low, span, counted, tallest = distribution(shown, stage)
    plot = CHART_WIDTH - MARGIN_LEFT - MARGIN_RIGHT
    slot = plot / BINS
    thickness = min(slot - 2, BAR_MAX)
    height = (
        MARGIN_TOP + len(shown) * (PANEL_HEIGHT + PANEL_GAP) - PANEL_GAP + AXIS_HEIGHT
    )

    def at(milliseconds: float) -> float:
        return MARGIN_LEFT + (milliseconds - low) / span * plot

    marks = [
        (
            f'<svg width="{CHART_WIDTH}" height="{height:.0f}" viewBox="0 0 {CHART_WIDTH} '
            f'{height:.0f}" role="img" aria-label="{escape(stage)} by variant">'
        )
    ]
    for index, variant in enumerate(shown):
        top = MARGIN_TOP + index * (PANEL_HEIGHT + PANEL_GAP)
        base = top + PANEL_HEIGHT
        values = collected(variant, stage)
        marks += [
            f'<line class="grid" x1="{MARGIN_LEFT}" y1="{top}" x2="{MARGIN_LEFT + plot}" y2="{top}"/>',
            f'<line class="axis" x1="{MARGIN_LEFT}" y1="{base}" x2="{MARGIN_LEFT + plot}" y2="{base}"/>',
            (
                f'<rect class="swatch" x="0" y="{top + 1}" width="10" height="10" rx="2" '
                f'fill="var(--series-{variant.colour})"/>'
            ),
            f'<text class="name" x="16" y="{top + 10}">{escape(variant.name)}</text>',
            (
                f'<text class="note" x="0" y="{top + 30}">n={len(values)} · p50 '
                f"{quantile(values, 0.5):.1f} · p90 {quantile(values, 0.9):.1f}ms</text>"
            ),
            f'<text class="tick" x="{MARGIN_LEFT - 8}" y="{top + 4}" text-anchor="end">{tallest}</text>',
            f'<text class="tick" x="{MARGIN_LEFT - 8}" y="{base + 4}" text-anchor="end">0</text>',
        ]
        # Behind the bars: the quantiles are there to be lined up between panels, and to say
        # where the bulk of a long tail's samples actually are.
        placed: list[float] = []
        for q, name in ((0.5, "p50"), (0.9, "p90")):
            x = at(quantile(values, q))
            marks.append(
                f'<line class="quantile" x1="{x:.1f}" y1="{top}" x2="{x:.1f}" y2="{base}"/>'
            )
            # Above the panel, where no bar can cover it. A label that would sit on the one
            # before it goes to the other side of its own line.
            anchor = "start" if all(abs(x - each) > 34 for each in placed) else "end"
            offset = 4 if anchor == "start" else -4
            marks.append(
                f'<text class="quantile-label" x="{x + offset:.1f}" y="{top - 5}" '
                f'text-anchor="{anchor}">{name}</text>'
            )
            placed.append(x)
        for index_of_bin, count in enumerate(counted[variant.name]):
            if not count:
                continue
            left = MARGIN_LEFT + (index_of_bin + 0.5) * slot - thickness / 2
            edge = low + index_of_bin * span / BINS
            marks.append(
                f'<path class="bar" fill="var(--series-{variant.colour})" tabindex="0" '
                f'data-series="{escape(variant.name)}" data-count="{count}" '
                f'data-range="{edge:.1f}-{edge + span / BINS:.1f} ms" '
                f'd="{bar_path(left, base, thickness, count / tallest * PANEL_HEIGHT)}"/>'
            )

    floor = MARGIN_TOP + len(shown) * (PANEL_HEIGHT + PANEL_GAP) - PANEL_GAP
    for index_of_bin in range(0, BINS + 1, BINS // 4):
        x = MARGIN_LEFT + index_of_bin * slot
        marks += [
            f'<line class="axis" x1="{x:.1f}" y1="{floor}" x2="{x:.1f}" y2="{floor + 5}"/>',
            (
                f'<text class="tick" x="{x:.1f}" y="{floor + 19}" text-anchor="middle">'
                f"{low + index_of_bin * span / BINS:.1f}</text>"
            ),
        ]
    marks.append(
        f'<text x="{MARGIN_LEFT + plot / 2:.0f}" y="{floor + 40}" text-anchor="middle">'
        f"milliseconds from the instant before the start call</text>"
    )
    return (
        "".join(marks)
        + "</svg>"
        + f'<p class="caption">{BINS} bins of {span / BINS:.2f}ms, shared by every panel, as is '
        f"the count axis: a full-height bar is {tallest} of the samples.</p>"
    )


def bar_path(left: float, base: float, width: float, height: float) -> str:
    """A bar with its data-end rounded and its baseline square."""
    radius = min(4.0, width / 2, height)
    top = base - height
    return (
        f"M{left:.1f},{base:.1f} V{top + radius:.1f} "
        f"Q{left:.1f},{top:.1f} {left + radius:.1f},{top:.1f} "
        f"H{left + width - radius:.1f} Q{left + width:.1f},{top:.1f} "
        f"{left + width:.1f},{top + radius:.1f} V{base:.1f} Z"
    )


def table(variants: list[Variant]) -> str:
    heads = "".join(f"<th>{escape(stage)}</th>" for stage in STAGES)
    rows = "".join(
        f'<tr><td><span class="swatch" style="background: var(--series-{variant.colour})">'
        f"</span>{escape(variant.name)} (n={len(variant.samples)})</td>"
        + "".join(f"<td>{cell(variant, stage)}</td>" for stage in STAGES)
        + "</tr>"
        for variant in variants
    )
    return (
        "<table><caption>milliseconds, p50/p90/max</caption>"
        f"<thead><tr><th></th>{heads}</tr></thead><tbody>{rows}</tbody></table>"
    )


def write_csv(path: str, variants: list[Variant]) -> None:
    lines = ["variant,sample," + ",".join(stage.replace(" ", "_") for stage in STAGES)]
    for variant in variants:
        for index, timeline in enumerate(variant.samples):
            values = measured(timeline)
            row = ",".join(
                f"{values[stage]:.3f}" if stage in values else "" for stage in STAGES
            )
            lines.append(f"{variant.name},{index},{row}")
    with open(path, "w") as file:
        file.write("\n".join(lines) + "\n")
    print(f"\n{sum(len(v.samples) for v in variants)} samples written to {path}")


async def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--samples", type=int, default=20, help="measured samples per variant"
    )
    parser.add_argument(
        "--warmup",
        type=int,
        default=3,
        help="samples per variant to run and discard first",
    )
    parser.add_argument(
        "--settle",
        type=float,
        default=SETTLE,
        metavar="SECONDS",
        help=f"quiet time between samples (default {SETTLE})",
    )
    parser.add_argument(
        "--variants",
        metavar="NAMES",
        help="comma-separated subset of: " + ", ".join(v.name for v in VARIANTS),
    )
    parser.add_argument(
        "--payload",
        type=size,
        default=PAYLOAD,
        metavar="BYTES",
        help=f"input carried to the Activity, k and M accepted (default {PAYLOAD_DEFAULT})",
    )
    parser.add_argument(
        "--html",
        nargs="?",
        const="",
        metavar="PATH",
        help="write the histograms to PATH (default /tmp/activity-start-latency-<tag>.html)",
    )
    parser.add_argument(
        "--csv",
        nargs="?",
        const="",
        metavar="PATH",
        help="write every sample to PATH (default /tmp/activity-start-latency-<tag>.csv)",
    )
    args = parser.parse_args()

    variants = VARIANTS
    if args.variants:
        wanted = [name.strip() for name in args.variants.split(",")]
        if unknown := [
            name for name in wanted if name not in {v.name for v in VARIANTS}
        ]:
            parser.error(f"no such variant: {', '.join(unknown)}")
        variants = [variant for variant in VARIANTS if variant.name in wanted]

    tag = uuid.uuid4().hex[:8]
    address = os.environ.get("TEMPORAL_ADDRESS", "localhost:7233")
    api_key = os.environ.get("TEMPORAL_API_KEY")
    try:
        client = await Client.connect(
            address,
            namespace=os.environ.get("TEMPORAL_NAMESPACE", "default"),
            api_key=api_key,
            tls=bool(api_key),
        )
    except RuntimeError as err:
        sys.exit(f"cannot reach a Temporal server at {address}: {err}")

    for variant in variants:
        variant.task_queue = (
            f"activity-start-latency-{variant.name.replace(' ', '-')}-{tag}-tq"
        )
    # Random, so that nothing along the way gets to compress it away.
    payload = os.urandom(args.payload)

    async with contextlib.AsyncExitStack() as stack:
        for variant in variants:
            await stack.enter_async_context(
                Worker(
                    client,
                    task_queue=variant.task_queue,
                    workflows=[SingleActivityWorkflow],
                    activities=[stamp],
                    workflow_runner=UnsandboxedWorkflowRunner(),
                )
            )
        for round_number in range(args.warmup + args.samples):
            measuring = round_number >= args.warmup
            # Rotated, so that no variant is always the one that goes first in a round.
            for variant in (
                variants[round_number % len(variants) :]
                + variants[: round_number % len(variants)]
            ):
                key = f"activity-start-latency-{tag}-{variant.name.replace(' ', '-')}-{round_number}"
                timeline = await sample(client, variant, key, payload)
                if measuring:
                    variant.samples.append(timeline)
                await asyncio.sleep(args.settle)
            done = round_number + 1 - (args.warmup if measuring else 0)
            print(
                f"\r{'measured' if measuring else 'warming up'} {done}"
                f"/{args.samples if measuring else args.warmup}",
                end="",
                file=sys.stderr,
                flush=True,
            )
        print(file=sys.stderr)

    report(variants)
    if args.html is not None:
        path = args.html or f"/tmp/activity-start-latency-{tag}.html"
        write_html(
            path,
            variants,
            ACTIVITY_BEGAN,
            [
                ("payload", human(args.payload)),
                ("samples", str(args.samples)),
                ("settle", f"{args.settle}s"),
                ("server", f"{address}/{client.namespace}"),
                (
                    "measured",
                    datetime.now(UTC).astimezone().isoformat(timespec="seconds"),
                ),
            ],
        )
        print(f"\nhistograms written to {path}")
    if args.csv is not None:
        write_csv(args.csv or f"/tmp/activity-start-latency-{tag}.csv", variants)


if __name__ == "__main__":
    asyncio.run(main())
