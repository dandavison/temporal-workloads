#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["temporalio"]
# ///
"""
Measure how long it takes for an Activity function to start running, from the moment the client
asks for it, over four ways of asking -- three of them a single-Activity Workflow (SAW) shedding
one round trip at a time, and the Standalone Activity that needs none of them:

  SAW               StartWorkflow, then a Workflow Task, then the Activity. The worker asks for
                    eager Activity execution, which the SDK does by default: if the server agrees,
                    it hands the Activity Task back on the response to the Workflow Task
                    completion rather than through Matching.
  SAW eager start   the same, with request_eager_start: the server returns the first Workflow Task
                    inline on the StartWorkflowExecution response, so the Workflow Task skips
                    Matching too.
  SAW eager + LA    the same again, but the Workflow runs a Local Activity: the worker executes it
                    during the Workflow Task, with no Activity Task and no second trip to the
                    server at all.
  SAA               StartActivity. One call, and the Activity Task goes to Matching, which hands
                    it to a poller.

Both eager paths are the server's to grant, per namespace: system.enableActivityEagerExecution and
system.enableEagerWorkflowStart. The dispatch column says whether the Activity's was granted --
0.0 means the Activity Task never went through Matching -- and a "SAW eager start" that is no
faster than "SAW" means the other was not.

The number reported is wall-clock in one process: the driver, the client and the worker are all
here, so a start and the Activity start it leads to are read off the same monotonic clock and no
clock skew or file-passing is involved. Each sample is one execution, run to completion before
the next one starts, and the variants are rotated round-robin so that whatever the machine or the
server is doing drifts across all of them equally rather than into one.

What is measured, the first three from the instant before the start call:

  start call returned  the client has the server's acknowledgement.
  workflow code began  the worker is executing the Workflow function (SAW only). Its timestamp is
                       taken inside the Workflow, which is not deterministic, and is only sound
                       because these Workflows are one Workflow Task long and never replay.
  activity began       the worker is executing the Activity function. This is the headline.
  matching dispatch    the Activity's scheduled_time to its started_time, which is a difference of
                       two of the server's own timestamps and so the one number here that no clock
                       skew can reach. A Local Activity has no such pair, and reports nothing.

Every variant carries a --payload of random bytes into the Activity, because a start with nothing
in it measures little: the payload is what the paths differ over. A SAW's goes to the server, back
out on the Workflow Task, in again on the Activity's schedule command and out once more on the
Activity Task; the SAA's makes one trip; the Local Activity's never leaves the worker after the
Workflow Task that carried it.

Each variant gets its own task queue and its own worker, so no variant waits behind another's
pollers. The Workflows run on an UnsandboxedWorkflowRunner: the sandbox re-imports this module
for every Workflow instance, which would be measuring the SDK's sandbox rather than the server.

Sampling faster than --settle allows is the way to get numbers that are wrong without looking it:
start the next execution before the worker's pollers are waiting again and the Activity Task has
to be read back off the queue instead of handed straight over, which on a local dev server puts
about 40ms on every hop -- so about 40ms on the SAA and about 80ms on a SAW, which still looks
like a plausible ratio.

The distributions are drawn underneath as a histogram per variant, one column of panels over one
x-axis, all sharing bin edges and a bar scale so that reading down a column compares the same
slice of time across all of them, each marked at its p50 and p90. --html draws the same thing as
a self-contained page.

Usage:
  ./temporal-workload-activity-start-latency [--samples N] [--warmup N] [--settle SECONDS]
                                             [--payload BYTES] [--variants NAMES]
                                             [--html [PATH]] [--csv [PATH]]

  temporal server start-dev \
      --dynamic-config-value system.enableActivityEagerExecution=true \
      --dynamic-config-value system.enableEagerWorkflowStart=true

Env vars:
  TEMPORAL_ADDRESS    (default localhost:7233)
  TEMPORAL_NAMESPACE  (default "default")
  TEMPORAL_API_KEY    (unset for local server)
"""

import argparse
import asyncio
import contextlib
import os
import sys
import time
import uuid
from collections.abc import Awaitable, Callable
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
from html import escape

from temporalio import activity, workflow
from temporalio.client import Client
from temporalio.common import RetryPolicy
from temporalio.worker import UnsandboxedWorkflowRunner, Worker

WORKFLOW_TYPE = "SingleActivityWorkflow"
ACTIVITY_TYPE = "Stamp"

START_TO_CLOSE_TIMEOUT = timedelta(seconds=30)
# One attempt: a retry would be measuring the retry, not the start.
RETRY_POLICY = RetryPolicy(maximum_attempts=1)
# Between samples. Long enough for the worker's pollers to be waiting again before the next
# execution is started: fire faster than that and a task arrives at a partition with no poller on
# it, waits to be read back off the queue instead of being handed straight over, and every number
# here grows by tens of milliseconds. See --settle.
SETTLE = 0.25

# Carried into the Activity, to put something on the wire and in the database worth timing. The
# server's own limits bound this: it warns over 512KiB per blob and rejects over 2MiB.
PAYLOAD_DEFAULT = "256k"

MILLI = 1e6
UNITS = {"k": 1024, "m": 1024**2}


def size(text: str) -> int:
    """Bytes, written as bytes or with a k or M suffix."""
    scale = UNITS.get(text[-1:].lower(), 1)
    return int(float(text[:-1] if scale > 1 else text) * scale)


def human(count: int) -> str:
    for suffix, unit in (("MiB", UNITS["m"]), ("KiB", UNITS["k"])):
        if count >= unit:
            return f"{count / unit:g}{suffix}"
    return f"{count} bytes"


PAYLOAD = size(PAYLOAD_DEFAULT)


@dataclass
class Timeline:
    """One execution's timestamps. All but dispatched are taken in this process off the monotonic
    clock; dispatched is a difference of two of the server's own timestamps."""

    requested: int
    accepted: int = 0
    workflow_began: int = 0
    activity_began: int = 0
    dispatched: int = 0


TIMELINES: dict[str, Timeline] = {}


@activity.defn(name=ACTIVITY_TYPE)
async def stamp(key: str, payload: bytes) -> int:
    timeline = TIMELINES[key]
    timeline.activity_began = time.monotonic_ns()
    info = activity.info()
    # A Local Activity's scheduled_time and started_time are the worker's own invention, not the
    # server's, so there is no dispatch to report.
    if not info.is_local:
        timeline.dispatched = int(
            (info.started_time - info.scheduled_time).total_seconds() * 1e9
        )
    return len(payload)


@workflow.defn(name=WORKFLOW_TYPE)
class SingleActivityWorkflow:
    @workflow.run
    async def run(self, key: str, payload: bytes, local: bool) -> int:
        TIMELINES[key].workflow_began = time.monotonic_ns()
        execute = (
            workflow.execute_local_activity if local else workflow.execute_activity
        )
        return await execute(
            ACTIVITY_TYPE,
            args=[key, payload],
            start_to_close_timeout=START_TO_CLOSE_TIMEOUT,
            retry_policy=RETRY_POLICY,
        )


@dataclass
class Variant:
    """One way of asking for the Activity, on a task queue and a worker of its own."""

    name: str
    run: "Callable[[Client, Variant, str, bytes], Awaitable[None]]"
    colour: str
    eager_start: bool = False
    local: bool = False
    task_queue: str = ""
    samples: list[Timeline] = field(default_factory=list)


async def run_standalone_activity(
    client: Client, variant: Variant, key: str, payload: bytes
) -> None:
    handle = await client.start_activity(
        ACTIVITY_TYPE,
        args=[key, payload],
        id=key,
        task_queue=variant.task_queue,
        start_to_close_timeout=START_TO_CLOSE_TIMEOUT,
        retry_policy=RETRY_POLICY,
    )
    TIMELINES[key].accepted = time.monotonic_ns()
    await handle.result()


async def run_workflow_activity(
    client: Client, variant: Variant, key: str, payload: bytes
) -> None:
    handle = await client.start_workflow(
        SingleActivityWorkflow.run,
        args=[key, payload, variant.local],
        id=key,
        task_queue=variant.task_queue,
        request_eager_start=variant.eager_start,
    )
    TIMELINES[key].accepted = time.monotonic_ns()
    await handle.result()


# Hue by surface, not by variant: the Workflow ones are one colour and the Standalone Activity
# another, both from the reference palette's validated leading slots. Which of the three Workflow
# variants a panel is showing comes from its title, which is the identity channel that never
# depends on telling two colours apart.
SAW = "2"
STANDALONE = "1"
VARIANTS = [
    Variant("SAW", run_workflow_activity, colour=SAW),
    Variant("SAW eager start", run_workflow_activity, colour=SAW, eager_start=True),
    Variant(
        "SAW eager + LA",
        run_workflow_activity,
        colour=SAW,
        eager_start=True,
        local=True,
    ),
    Variant("SAA", run_standalone_activity, colour=STANDALONE),
]
BASELINE = "SAA"


async def sample(
    client: Client, variant: Variant, key: str, payload: bytes
) -> Timeline:
    timeline = TIMELINES[key] = Timeline(requested=time.monotonic_ns())
    await variant.run(client, variant, key, payload)
    return timeline


ACTIVITY_BEGAN = "activity began"
DISPATCHED = "matching dispatch"
STAGES = ["start call returned", "workflow code began", ACTIVITY_BEGAN, DISPATCHED]
# What each stage is called where four columns of numbers have to fit on a terminal.
ABBREVIATED = dict(zip(STAGES, ["start call", "workflow code", "activity", "dispatch"]))


def measured(timeline: Timeline) -> dict[str, float]:
    """Milliseconds for each stage the sample got through: from the start call for all of them
    but the dispatch, which is a duration in its own right."""
    since_request = {
        "start call returned": timeline.accepted,
        "workflow code began": timeline.workflow_began,
        ACTIVITY_BEGAN: timeline.activity_began,
    }
    stages = {
        stage: (at - timeline.requested) / MILLI
        for stage, at in since_request.items()
        if at
    }
    if timeline.dispatched:
        stages[DISPATCHED] = timeline.dispatched / MILLI
    return stages


def quantile(values: list[float], q: float) -> float:
    """Nearest-rank, which for these sample counts says something a linear interpolation of two
    neighbours would not."""
    ordered = sorted(values)
    return ordered[min(int(q * len(ordered)), len(ordered) - 1)]


def collected(variant: Variant, stage: str) -> list[float]:
    return [
        milliseconds
        for timeline in variant.samples
        if (milliseconds := measured(timeline).get(stage)) is not None
    ]


WIDTH = 18


def cell(variant: Variant, stage: str) -> str:
    values = collected(variant, stage)
    if not values:
        return "-"
    return f"{quantile(values, 0.5):.1f}/{quantile(values, 0.9):.1f}/{max(values):.1f}"


def report(variants: list[Variant]) -> None:
    print("\nmilliseconds, p50/p90/max\n")
    named = {
        variant.name: f"{variant.name} (n={len(variant.samples)})"
        for variant in variants
    }
    names = max(len(label) for label in named.values()) + 2
    header = "".join(f"{ABBREVIATED[stage]:>{WIDTH}}" for stage in STAGES)
    print(f"{'':<{names}}{header}")
    for variant in variants:
        row = "".join(f"{cell(variant, stage):>{WIDTH}}" for stage in STAGES)
        print(f"{named[variant.name]:<{names}}{row}")

    print(
        "\nEverything but the dispatch is measured from the instant before the start call, on this\n"
        "process's monotonic clock. The dispatch is the Activity's scheduled_time to its\n"
        "started_time: both are the server's own timestamps, so it is the one number here that no\n"
        "clock skew can reach, and it covers the hop from the Activity being scheduled to a worker\n"
        "being given it."
    )
    against = next((v for v in variants if v.name == BASELINE), variants[0])
    baseline = quantile(collected(against, ACTIVITY_BEGAN) or [0.0], 0.5)
    if baseline:
        relative = ", ".join(
            f"{variant.name} {quantile(collected(variant, ACTIVITY_BEGAN), 0.5) / baseline:.2f}x"
            for variant in variants
            if variant is not against and collected(variant, ACTIVITY_BEGAN)
        )
        print(
            f"\nmedian time to the Activity starting, against {against.name}: {relative}"
        )
    histograms(variants, ACTIVITY_BEGAN)


BINS = 24
ROWS = 6
# The count and the axis glyph, which sit between the panel's gutter and its first bin.
AXIS = 5
# Eighths of a row, so a bar's last cell can show where between two rows it stopped.
BLOCKS = "▁▂▃▄▅▆▇█"


def distribution(
    variants: list[Variant], stage: str
) -> tuple[float, float, dict[str, list[int]], int]:
    """Bin edges and a bar scale shared by every variant, so that a column is the same slice of
    time whichever histogram it is read in."""
    series = {variant.name: collected(variant, stage) for variant in variants}
    low = min(min(values) for values in series.values())
    high = max(max(values) for values in series.values())
    span = (high - low) or 1.0
    counted = {name: binned(values, low, span) for name, values in series.items()}
    return low, span, counted, max(max(counts) for counts in counted.values())


def histograms(variants: list[Variant], stage: str) -> None:
    shown = [variant for variant in variants if collected(variant, stage)]
    if not shown:
        return
    low, span, counted, tallest = distribution(shown, stage)
    print(
        f"\n{stage}, ms: {BINS} bins of {span / BINS:.2f}ms, a full-height bar being {tallest} "
        f"of the samples\n"
    )
    width = max(len(variant.name) for variant in shown) + 1
    for variant in shown:
        values = collected(variant, stage)
        # The gutter carries the name and, under it, the quantiles the panel is marked at.
        gutter = [
            variant.name,
            f"p50 {quantile(values, 0.5):.1f}",
            f"p90 {quantile(values, 0.9):.1f}",
        ]
        marked = {
            round((quantile(values, q) - low) / span * (BINS - 1)) for q in (0.5, 0.9)
        }
        for row in reversed(range(ROWS)):
            label = f"{gutter.pop(0) if gutter else '':<{width}}"
            axis = f"{tallest:>3} ┤" if row == ROWS - 1 else f"{'':>3} │"
            bars = "".join(bar(count, tallest, row) for count in counted[variant.name])
            print((label + axis + bars).rstrip())
        print(
            f"{'':<{width}}{0:>3} └"
            + "".join("┴" if index in marked else "─" for index in range(BINS))
        )
    print(" " * (width + AXIS) + ticks(low, span))


def binned(values: list[float], low: float, span: float) -> list[int]:
    counts = [0] * BINS
    for value in values:
        counts[min(int((value - low) / span * BINS), BINS - 1)] += 1
    return counts


def bar(count: int, tallest: int, row: int) -> str:
    """How much of this bin's bar falls in this row: all of it, none of it, or part."""
    filled = count / tallest * ROWS - row
    if filled >= 1:
        return "█"
    if filled <= 0:
        return " "
    return BLOCKS[int(filled * len(BLOCKS))]


def ticks(low: float, span: float) -> str:
    line = [" "] * (BINS + 8)
    for position in range(0, BINS, BINS // 4):
        label = f"{low + position * span / BINS:.0f}"
        line[position : position + len(label)] = label
    return "".join(line).rstrip()


