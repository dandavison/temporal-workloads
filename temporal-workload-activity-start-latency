def write_html(
    path: str, variants: list[Variant], stage: str, meta: list[tuple[str, str]]
) -> None:
    """A self-contained page: the same histograms, plus the table they summarise."""
    described = " · ".join(f"{label} {value}" for label, value in meta)
    document = f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Time to an Activity starting</title>
<style>{STYLE}</style>
</head>
<body>
<div class="viz-root">
<h1>Time to an Activity starting</h1>
<p class="meta">{escape(described)}</p>
<div class="card">{panels(variants, stage)}</div>
