#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["temporalio"]
# ///
"""
Exercise Activity heartbeating on both product surfaces that use the Activity CHASM
component -- a Workflow Activity (WFA) and a Standalone Activity (SAA) -- with one
long-running heartbeating Activity per surface, failing several attempts before succeeding,
where each failure reports its own heartbeat payload that is deliberately *behind* the last
payload heartbeated during that attempt.

The Activity processes CHUNKS_TOTAL chunks and heartbeats its per-chunk progress. Chunks are
only durable at COMMITTED_BATCH_SIZE boundaries, so when an attempt dies it must tell the
server to resume from the last committed boundary rather than from the optimistic per-chunk
progress the server already has. It does that via
RespondActivityTaskFailed.last_heartbeat_details, which the server treats as a heartbeat
before retrying (see UpdateActivityProgress in
service/history/api/respondactivitytaskfailed/api.go).

sdk-core never populates last_heartbeat_details when a worker completes an Activity task as
failed (sdk-core#293), so the only way to set it from Python is the async-completion client
API: the Activity fails its own task through Client.get_async_activity_handle(...).fail() and
then raises CompleteAsyncError so the worker keeps quiet.

Before failing, each attempt waits until the server is observed holding its latest per-chunk
heartbeat (core throttles heartbeats to 0.8 * heartbeat_timeout, so the last
activity.heartbeat() call is not necessarily on the wire). That is what makes the
demonstration a proof rather than a coincidence: the next attempt resumes from the failure's
payload even though the server had a later payload from an ordinary heartbeat. WFA progress
is read from DescribeWorkflowExecution's pending activities; SAA progress from
DescribeActivityExecution, which requires include_heartbeat_details and so is issued as a raw
RPC rather than through ActivityHandle.describe().

Usage:
  ./temporal-workload-activity-heartbeat

Env vars:
  TEMPORAL_ADDRESS    (default localhost:7233)
  TEMPORAL_NAMESPACE  (default "default")
  TEMPORAL_API_KEY    (unset for local server)
"""

import asyncio
import itertools
import os
import sys
import uuid
from dataclasses import dataclass, field
from datetime import timedelta
from typing import NoReturn

from temporalio import activity, workflow
from temporalio.api.workflowservice.v1 import DescribeActivityExecutionRequest
from temporalio.client import Client
from temporalio.common import RetryPolicy
from temporalio.exceptions import ApplicationError
from temporalio.worker import UnsandboxedWorkflowRunner, Worker

WORKFLOW_TYPE = "HeartbeatWorkload"
ACTIVITY_TYPE = "ProcessChunks"
TASK_QUEUE = "heartbeat-workload-tq"

CHUNKS_TOTAL = 20
COMMITTED_BATCH_SIZE = 4
CHUNKS_PER_ATTEMPT = 5
CHUNK_SECONDS = 0.5
SUCCEED_ON_ATTEMPT = 4
START_TO_CLOSE_TIMEOUT = timedelta(minutes=2)
HEARTBEAT_TIMEOUT = timedelta(seconds=5)
HEARTBEAT_THROTTLE_INTERVAL = timedelta(seconds=1)
RETRY_POLICY = RetryPolicy(
    maximum_attempts=SUCCEED_ON_ATTEMPT,
    initial_interval=timedelta(seconds=1),
    backoff_coefficient=1.0,
)


@dataclass
class Attempt:
    attempt: int
    resumed_from: int
    server_progress_at_failure: int | None = None
    reported_checkpoint: int | None = None


@dataclass
class Surface:
    """One of the two product surfaces backed by the Activity CHASM component."""

    name: str
    attempts: list[Attempt] = field(default_factory=list)


WFA = Surface("WFA")
SAA = Surface("SAA")


@activity.defn(name=ACTIVITY_TYPE)
async def process_chunks() -> str:
    info = activity.info()
    surface = WFA if info.in_workflow else SAA
    resumed_from = info.heartbeat_details[0] if info.heartbeat_details else 0
    record = Attempt(attempt=info.attempt, resumed_from=resumed_from)
    surface.attempts.append(record)
    log(f"{surface.name} attempt {info.attempt}: resuming from chunk {resumed_from}")

    chunk = resumed_from
    while chunk < CHUNKS_TOTAL:
        await asyncio.sleep(CHUNK_SECONDS)
        chunk += 1
        activity.heartbeat(chunk)
        log(
            f"{surface.name} attempt {info.attempt}: processed chunk {chunk}, "
            f"heartbeated {chunk}"
        )
        if (
            info.attempt < SUCCEED_ON_ATTEMPT
            and chunk - resumed_from >= CHUNKS_PER_ATTEMPT
        ):
            await fail_at_committed_checkpoint(surface, record, chunk)
    log(f"{surface.name} attempt {info.attempt}: all {CHUNKS_TOTAL} chunks processed")
    return f"processed {CHUNKS_TOTAL} chunks"


async def fail_at_committed_checkpoint(
    surface: Surface, record: Attempt, chunk: int
) -> NoReturn:
    """Fail this attempt, reporting the last committed batch boundary rather than the
    per-chunk progress the server has already seen heartbeated."""
    info = activity.info()
    await await_server_progress(chunk)
    record.server_progress_at_failure = chunk
    committed = chunk - chunk % COMMITTED_BATCH_SIZE
    record.reported_checkpoint = committed
    log(
        f"{surface.name} attempt {info.attempt}: failing; server heartbeat progress is "
        f"{chunk}, failing with last_heartbeat_details=[{committed}]"
    )
    await (
        activity.client()
        .get_async_activity_handle(task_token=info.task_token)
        .fail(
            ApplicationError(f"attempt {info.attempt} died after chunk {chunk}"),
            last_heartbeat_details=[committed],
        )
    )
    activity.raise_complete_async()


async def await_server_progress(chunk: int) -> None:
    """Block until the server has recorded chunk as this Activity's heartbeat progress. Do not
    heartbeat while waiting: a heartbeat recorded after the one we are waiting for would leave
    throttled details pending in the worker, which could reach the server after the failure and
    confound the demonstration."""
    while await server_progress() != chunk:
        await asyncio.sleep(0.1)


async def server_progress() -> int | None:
    info = activity.info()
    client = activity.client()
    if info.in_workflow:
        description = await client.get_workflow_handle(
            info.workflow_id or "", run_id=info.workflow_run_id
        ).describe()
        details = next(
            (
                pending.heartbeat_details.payloads
                for pending in description.raw_description.pending_activities
                if pending.activity_id == info.activity_id
            ),
            None,
        )
    else:
        response = await client.workflow_service.describe_activity_execution(
            DescribeActivityExecutionRequest(
                namespace=info.namespace,
                activity_id=info.activity_id,
                run_id=info.activity_run_id or "",
                include_heartbeat_details=True,
            )
        )
        details = response.info.heartbeat_details.payloads
    decoded = await client.data_converter.decode(details) if details else []
    return decoded[0] if decoded else None


@workflow.defn(name=WORKFLOW_TYPE)
class HeartbeatWorkload:
    @workflow.run
    async def run(self) -> str:
        return await workflow.execute_activity(
            ACTIVITY_TYPE,
            start_to_close_timeout=START_TO_CLOSE_TIMEOUT,
            heartbeat_timeout=HEARTBEAT_TIMEOUT,
            retry_policy=RETRY_POLICY,
        )


def log(message: str) -> None:
    print(message, flush=True)


def report(surface: Surface) -> bool:
    log("")
    log(
        f"{surface.name}  {'attempt':>8}  {'resumed from':>12}  {'server saw':>10}  "
        f"{'reported':>8}"
    )
    for record in surface.attempts:
        log(
            f"{' ' * len(surface.name)}  {record.attempt:>8}  {record.resumed_from:>12}  "
            f"{record.server_progress_at_failure!s:>10}  "
            f"{record.reported_checkpoint!s:>8}"
        )
    log("")

    ok = True
    for previous, current in itertools.pairwise(surface.attempts):
        if previous.reported_checkpoint == previous.server_progress_at_failure:
            ok = False
            log(
                f"{surface.name} attempt {previous.attempt} reported the same checkpoint the "
                f"server already had ({previous.reported_checkpoint}): nothing is demonstrated"
            )
        if current.resumed_from != previous.reported_checkpoint:
            ok = False
            log(
                f"{surface.name} attempt {current.attempt} resumed from {current.resumed_from}, "
                f"expected {previous.reported_checkpoint} reported by attempt "
                f"{previous.attempt}'s failure"
            )
        else:
            log(
                f"{surface.name} attempt {current.attempt} resumed from {current.resumed_from}: "
                f"the payload attempt {previous.attempt}'s failure reported, not the "
                f"{previous.server_progress_at_failure} it had heartbeated"
            )
    return ok


async def run_workflow_activity(client: Client) -> None:
    handle = await client.start_workflow(
        HeartbeatWorkload.run,
        id=f"heartbeat-workload-{uuid.uuid4().hex[:8]}",
        task_queue=TASK_QUEUE,
    )
    log(f"started workflow {handle.id}")
    log(f"workflow result: {await handle.result()}")


async def run_standalone_activity(client: Client) -> None:
    handle = await client.start_activity(
        process_chunks,
        id=f"heartbeat-workload-activity-{uuid.uuid4().hex[:8]}",
        task_queue=TASK_QUEUE,
        start_to_close_timeout=START_TO_CLOSE_TIMEOUT,
        heartbeat_timeout=HEARTBEAT_TIMEOUT,
        retry_policy=RETRY_POLICY,
    )
    log(f"started activity {handle.id}")
    log(f"activity result: {await handle.result()}")


async def main() -> None:
    client = await Client.connect(
        os.environ.get("TEMPORAL_ADDRESS", "localhost:7233"),
        namespace=os.environ.get("TEMPORAL_NAMESPACE", "default"),
        api_key=os.environ.get("TEMPORAL_API_KEY"),
        tls=bool(os.environ.get("TEMPORAL_API_KEY")),
    )
    worker = Worker(
        client,
        task_queue=TASK_QUEUE,
        workflows=[HeartbeatWorkload],
        activities=[process_chunks],
        workflow_runner=UnsandboxedWorkflowRunner(),
        # Keep heartbeats flowing to the server promptly: the default throttle is
        # 0.8 * heartbeat_timeout, which each attempt would have to wait out before failing.
        max_heartbeat_throttle_interval=HEARTBEAT_THROTTLE_INTERVAL,
    )
    async with worker:
        await run_workflow_activity(client)
        await run_standalone_activity(client)

    if not all([report(WFA), report(SAA)]):
        sys.exit("heartbeat resumption did not behave as described")
    log("heartbeat resumption behaved as described on both surfaces")


if __name__ == "__main__":
    asyncio.run(main())
