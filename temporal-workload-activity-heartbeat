#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.12"
# dependencies = ["temporalio"]
# ///
"""
Exercise Activity heartbeating: one long-running heartbeating Activity inside a Workflow,
failing several attempts before succeeding, where each failure reports its own heartbeat
payload that is deliberately *behind* the last payload heartbeated during that attempt.

The Activity processes CHUNKS_TOTAL chunks and heartbeats its per-chunk progress. Chunks are
only durable at COMMITTED_BATCH_SIZE boundaries, so when an attempt dies it must tell the
server to resume from the last committed boundary rather than from the optimistic per-chunk
progress the server already has. It does that via
RespondActivityTaskFailed.last_heartbeat_details, which the server treats as a heartbeat
before retrying (see UpdateActivityProgress in
service/history/api/respondactivitytaskfailed/api.go).

sdk-core never populates last_heartbeat_details when a worker completes an Activity task as
failed (sdk-core#293), so the only way to set it from Python is the async-completion client
API: the Activity fails its own task through Client.get_async_activity_handle(...).fail() and
then raises CompleteAsyncError so the worker keeps quiet.

Before failing, each attempt waits until DescribeWorkflowExecution shows the server holding
its latest per-chunk heartbeat (core throttles heartbeats to 0.8 * heartbeat_timeout, so the
last activity.heartbeat() call is not necessarily on the wire). That is what makes the
demonstration a proof rather than a coincidence: the next attempt resumes from the failure's
payload even though the server had a later payload from an ordinary heartbeat.

Usage:
  ./temporal-workload-activity-heartbeat

Env vars:
  TEMPORAL_ADDRESS    (default localhost:7233)
  TEMPORAL_NAMESPACE  (default "default")
  TEMPORAL_API_KEY    (unset for local server)
"""

import asyncio
import itertools
import os
import sys
import uuid
from dataclasses import dataclass
from datetime import timedelta
from typing import NoReturn

from temporalio import activity, workflow
from temporalio.client import Client
from temporalio.common import RetryPolicy
from temporalio.exceptions import ApplicationError
from temporalio.worker import UnsandboxedWorkflowRunner, Worker

WORKFLOW_TYPE = "HeartbeatWorkload"
ACTIVITY_TYPE = "ProcessChunks"
TASK_QUEUE = "heartbeat-workload-tq"

CHUNKS_TOTAL = 20
COMMITTED_BATCH_SIZE = 4
CHUNKS_PER_ATTEMPT = 5
CHUNK_SECONDS = 0.5
SUCCEED_ON_ATTEMPT = 4
HEARTBEAT_TIMEOUT = timedelta(seconds=5)


@dataclass
class Attempt:
    attempt: int
    resumed_from: int
    server_progress_at_failure: int | None = None
    reported_checkpoint: int | None = None


ATTEMPTS: list[Attempt] = []


@activity.defn(name=ACTIVITY_TYPE)
async def process_chunks() -> str:
    info = activity.info()
    resumed_from = info.heartbeat_details[0] if info.heartbeat_details else 0
    record = Attempt(attempt=info.attempt, resumed_from=resumed_from)
    ATTEMPTS.append(record)
    log(f"attempt {info.attempt}: resuming from chunk {resumed_from}")

    chunk = resumed_from
    while chunk < CHUNKS_TOTAL:
        await asyncio.sleep(CHUNK_SECONDS)
        chunk += 1
        activity.heartbeat(chunk)
        log(f"attempt {info.attempt}: processed chunk {chunk}, heartbeated {chunk}")
        if (
            info.attempt < SUCCEED_ON_ATTEMPT
            and chunk - resumed_from >= CHUNKS_PER_ATTEMPT
        ):
            await fail_at_committed_checkpoint(record, chunk)
    log(f"attempt {info.attempt}: all {CHUNKS_TOTAL} chunks processed")
    return f"processed {CHUNKS_TOTAL} chunks"


async def fail_at_committed_checkpoint(record: Attempt, chunk: int) -> NoReturn:
    """Fail this attempt, reporting the last committed batch boundary rather than the
    per-chunk progress the server has already seen heartbeated."""
    info = activity.info()
    await await_server_progress(chunk)
    record.server_progress_at_failure = chunk
    committed = chunk - chunk % COMMITTED_BATCH_SIZE
    record.reported_checkpoint = committed
    log(
        f"attempt {info.attempt}: failing; server heartbeat progress is {chunk}, "
        f"failing with last_heartbeat_details=[{committed}]"
    )
    await (
        activity.client()
        .get_async_activity_handle(task_token=info.task_token)
        .fail(
            ApplicationError(f"attempt {info.attempt} died after chunk {chunk}"),
            last_heartbeat_details=[committed],
        )
    )
    activity.raise_complete_async()


async def await_server_progress(chunk: int) -> None:
    """Block until the server has recorded chunk as this Activity's heartbeat progress.
    Heartbeats are throttled by core, so re-heartbeat while waiting for one to be sent."""
    while await server_progress() != chunk:
        activity.heartbeat(chunk)
        await asyncio.sleep(0.2)


async def server_progress() -> int | None:
    info = activity.info()
    client = activity.client()
    description = await client.get_workflow_handle(
        info.workflow_id, run_id=info.workflow_run_id
    ).describe()
    for pending in description.raw_description.pending_activities:
        if pending.activity_id == info.activity_id:
            details = await client.data_converter.decode(
                pending.heartbeat_details.payloads
            )
            return details[0] if details else None
    return None


@workflow.defn(name=WORKFLOW_TYPE)
class HeartbeatWorkload:
    @workflow.run
    async def run(self) -> str:
        return await workflow.execute_activity(
            ACTIVITY_TYPE,
            start_to_close_timeout=timedelta(minutes=2),
            heartbeat_timeout=HEARTBEAT_TIMEOUT,
            retry_policy=RetryPolicy(
                maximum_attempts=SUCCEED_ON_ATTEMPT,
                initial_interval=timedelta(seconds=1),
                backoff_coefficient=1.0,
            ),
        )


def log(message: str) -> None:
    print(message, flush=True)


def report() -> bool:
    log("")
    log(f"{'attempt':>8}  {'resumed from':>12}  {'server saw':>10}  {'reported':>8}")
    for record in ATTEMPTS:
        log(
            f"{record.attempt:>8}  {record.resumed_from:>12}  "
            f"{record.server_progress_at_failure!s:>10}  "
            f"{record.reported_checkpoint!s:>8}"
        )
    log("")

    ok = True
    for previous, current in itertools.pairwise(ATTEMPTS):
        if previous.reported_checkpoint == previous.server_progress_at_failure:
            ok = False
            log(
                f"attempt {previous.attempt} reported the same checkpoint the server already "
                f"had ({previous.reported_checkpoint}): nothing is demonstrated"
            )
        if current.resumed_from != previous.reported_checkpoint:
            ok = False
            log(
                f"attempt {current.attempt} resumed from {current.resumed_from}, expected "
                f"{previous.reported_checkpoint} reported by attempt {previous.attempt}'s failure"
            )
        else:
            log(
                f"attempt {current.attempt} resumed from {current.resumed_from}: the payload "
                f"attempt {previous.attempt}'s failure reported, not the {previous.server_progress_at_failure} "
                f"it had heartbeated"
            )
    return ok


async def main() -> None:
    client = await Client.connect(
        os.environ.get("TEMPORAL_ADDRESS", "localhost:7233"),
        namespace=os.environ.get("TEMPORAL_NAMESPACE", "default"),
        api_key=os.environ.get("TEMPORAL_API_KEY"),
        tls=bool(os.environ.get("TEMPORAL_API_KEY")),
    )
    worker = Worker(
        client,
        task_queue=TASK_QUEUE,
        workflows=[HeartbeatWorkload],
        activities=[process_chunks],
        workflow_runner=UnsandboxedWorkflowRunner(),
    )
    async with worker:
        handle = await client.start_workflow(
            HeartbeatWorkload.run,
            id=f"heartbeat-workload-{uuid.uuid4().hex[:8]}",
            task_queue=TASK_QUEUE,
        )
        log(f"started workflow {handle.id}")
        log(f"workflow result: {await handle.result()}")

    if not report():
        sys.exit("heartbeat resumption did not behave as described")
    log("heartbeat resumption behaved as described")


if __name__ == "__main__":
    asyncio.run(main())
