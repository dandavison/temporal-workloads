# Invalid targeting
# --------------------------------------------------------------------------- #

INVALID = "invalid targeting"

# Every invalid row of the targeting matrix. A single operation needs
# --activity-id, optionally with --workflow-id and/or --run-id; --query is
# mutually exclusive with both --workflow-id and --run-id; pause has no --query
# at all.
QUERY = f'WorkflowType="{WORKFLOW_TYPE}"'
INVALID_CASES: list[dict[str, str]] = [
    {},
    {"--run-id": "r-id"},
    {"--run-id": "r-id", "--query": QUERY},
    {"--workflow-id": "w-id"},
    {"--workflow-id": "w-id", "--query": QUERY},
    {"--workflow-id": "w-id", "--run-id": "r-id"},
    {"--workflow-id": "w-id", "--run-id": "r-id", "--query": QUERY},
    {"--activity-id": "a-id", "--run-id": "r-id", "--query": QUERY},
    {"--activity-id": "a-id", "--workflow-id": "w-id", "--query": QUERY},
    {
        "--activity-id": "a-id",
        "--workflow-id": "w-id",
        "--run-id": "r-id",
        "--query": QUERY,
    },
]


@test(INVALID)
async def test_invalid_targeting_matrix(ctx: Ctx) -> None:
    accepted: list[str] = []
    for command in ("pause", "unpause", "reset", "update-options"):
        for case in INVALID_CASES:
            args = ["activity", command]
            for flag, value in case.items():
                args += [flag, value]
            if command != "pause":  # pause has no batch mode, hence no --yes
                args.append("--yes")
            res = await cli(ctx, *args)
            if res.code == 0:
                accepted.append(f"{command} {sorted(case)}")
    if accepted:
        raise AssertionError(f"invalid targeting accepted: {'; '.join(accepted)}")


@test(INVALID)
async def test_missing_target_error_names_the_flags(ctx: Ctx) -> None:
    """The error tells the user how to retarget: --activity-id plus the optional
    --workflow-id/--run-id, and --query for the batch-capable operations."""
    for command in ("pause", "unpause", "reset", "update-options"):
        res = await cli_fails(ctx, "activity", command)
        for flag in ("--activity-id", "--workflow-id", "--run-id"):
            if flag not in res.stderr:
                raise AssertionError(
                    f"{command} error should name {flag}: {res.stderr.strip()!r}"
                )
        mentions_query = "--query" in res.stderr
        if command == "pause" and mentions_query:
            raise AssertionError(
                f"pause has no --query mode but its error mentions it: "
                f"{res.stderr.strip()!r}"
            )
        if command != "pause" and not mentions_query:
            raise AssertionError(
                f"{command} error should name --query: {res.stderr.strip()!r}"
            )


