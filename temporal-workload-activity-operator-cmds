@test(SAA_UPDATE)
async def test_update_options_start_delay_before_dispatch(ctx: Ctx) -> None:
    """--start-delay may be shortened before the first dispatch; 0s makes the
    Activity Task available immediately."""
    handle = await start_standalone(
        ctx, SUCCEED, start_delay=timedelta(minutes=5), wait_for_attempt=0
    )
    info = await saa_info(ctx, handle)
    assert_equal(info.start_delay.ToTimedelta(), timedelta(minutes=5), "start delay")
    assert_equal(
        DISPATCH_QUEUES[handle.id],
        [],
        "activity should not be dispatched while delayed",
    )

    res = await cli_ok(
        ctx,
        "activity",
        "update-options",
        "--activity-id",
        handle.id,
        "--start-delay",
        "0s",
    )
    assert_equal(res.json["StartDelay"], 0, "echoed start delay")
    await wait_until("activity to complete", lambda: saa_completed(ctx, handle))


