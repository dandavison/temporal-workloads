SAA_UPDATE = "standalone activity: update-options"


@test(SAA_UPDATE)
async def test_update_options_all_flags(ctx: Ctx) -> None:
    handle = await start_standalone(ctx)
    res = await cli_ok(
        ctx,
        "activity",
        "update-options",
        "--activity-id",
        handle.id,
        "--run-id",
        run_id(handle),
        "--identity",
        IDENTITY,
        "--schedule-to-close-timeout",
        "120s",
        "--schedule-to-start-timeout",
        "30s",
        "--start-to-close-timeout",
        "20s",
        "--heartbeat-timeout",
        "15s",
        "--retry-initial-interval",
        "3s",
        "--retry-maximum-interval",
        "9s",
        "--retry-backoff-coefficient",
        "1.5",
        "--retry-maximum-attempts",
        "7",
    )
    # The command echoes what the server applied.
    echoed = res.json
    assert_equal(
        echoed["ScheduleToCloseTimeout"],
        nanos(timedelta(seconds=120)),
        "echoed schedule-to-close timeout",
    )
    assert_equal(
        echoed["StartToCloseTimeout"],
        nanos(timedelta(seconds=20)),
        "echoed start-to-close timeout",
    )
    assert_equal(echoed["BackoffCoefficient"], 1.5, "echoed retry backoff coefficient")
    assert_equal(echoed["MaximumAttempts"], 7, "echoed retry maximum attempts")

    info = await saa_info(ctx, handle)
    assert_equal(
        info.schedule_to_close_timeout.ToTimedelta(),
        timedelta(seconds=120),
        "schedule-to-close timeout",
    )
    assert_equal(
        info.schedule_to_start_timeout.ToTimedelta(),
        timedelta(seconds=30),
        "schedule-to-start timeout",
    )
    assert_equal(
        info.start_to_close_timeout.ToTimedelta(),
        timedelta(seconds=20),
        "start-to-close timeout",
    )
    assert_equal(
        info.heartbeat_timeout.ToTimedelta(),
        timedelta(seconds=15),
        "heartbeat timeout",
    )
    assert_equal(
        info.retry_policy.initial_interval.ToTimedelta(),
        timedelta(seconds=3),
        "retry initial interval",
    )
    assert_equal(
        info.retry_policy.maximum_interval.ToTimedelta(),
        timedelta(seconds=9),
        "retry maximum interval",
    )
    assert_equal(
        info.retry_policy.backoff_coefficient, 1.5, "retry backoff coefficient"
    )
    assert_equal(info.retry_policy.maximum_attempts, 7, "retry maximum attempts")


