@dataclass
class Config:
    address: str
    namespace: str
    api_key: str | None
    cli: str
    verbose: bool

    @staticmethod
    def from_args(args: argparse.Namespace) -> Config:
        return Config(
            address=os.environ.get("TEMPORAL_ADDRESS", "localhost:7233"),
            namespace=os.environ.get("TEMPORAL_NAMESPACE", "default"),
            api_key=os.environ.get("TEMPORAL_API_KEY"),
            cli=os.environ.get("TEMPORAL_CLI", "temporal"),
            verbose=args.verbose,
        )


@dataclass
class Ctx:
    cfg: Config
    client: Client
    cleanups: list[Callable[[], Awaitable[None]]] = field(default_factory=list)


@dataclass
class CliResult:
    cmdline: str
    code: int
    stdout: str
    stderr: str

    @property
    def json(self) -> Any:
        return json.loads(self.stdout) if self.stdout.strip() else None


async def cli(ctx: Ctx, *args: str) -> CliResult:
    cmd = [
        ctx.cfg.cli,
        *args,
        "--address",
        ctx.cfg.address,
        "--namespace",
        ctx.cfg.namespace,
        "--output",
        "json",
    ]
    if ctx.cfg.api_key:
        cmd += ["--api-key", ctx.cfg.api_key, "--tls"]
    cmdline = shlex.join(cmd)
    if ctx.cfg.verbose:
        print(f"        $ {cmdline}")
    proc = await asyncio.create_subprocess_exec(
        *cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE
    )
    out, err = await asyncio.wait_for(proc.communicate(), timeout=60)
    return CliResult(cmdline, proc.returncode or 0, out.decode(), err.decode())


async def cli_ok(ctx: Ctx, *args: str) -> CliResult:
    res = await cli(ctx, *args)
    if res.code != 0:
        raise AssertionError(
            f"expected success from `{res.cmdline}`: "
            f"exit={res.code} stderr={res.stderr.strip()!r}"
        )
    return res


async def cli_fails(ctx: Ctx, *args: str, contains: str = "") -> CliResult:
    res = await cli(ctx, *args)
    if res.code == 0:
        raise AssertionError(
            f"expected failure from `{res.cmdline}` but it succeeded: "
            f"{res.stdout.strip()!r}"
        )
    if contains and contains not in res.stderr:
        raise AssertionError(
            f"expected {contains!r} in stderr of `{res.cmdline}`, "
            f"got {res.stderr.strip()!r}"
        )
    return res


async def wait_until(
    what: str, pred: Callable[[], Awaitable[bool]], timeout: float = 30.0
) -> None:
    deadline = time.monotonic() + timeout
    while True:
        if await pred():
            return
        if time.monotonic() >= deadline:
            raise AssertionError(f"timed out after {timeout}s waiting for {what}")
        await asyncio.sleep(0.2)


def assert_equal(actual: Any, expected: Any, what: str) -> None:
    if actual != expected:
        raise AssertionError(f"{what}: expected {expected!r}, got {actual!r}")


def nanos(duration: timedelta) -> int:
    """`update-options` prints Go time.Duration values, i.e. nanoseconds."""
    return int(duration / timedelta(microseconds=1)) * 1000


