ACTIVITY_TYPE = "ActivityOperatorTestActivity"
WORKFLOW_TYPE = "ActivityOperatorTestWorkflow"
PRIMARY_TASK_QUEUE = "activity-operator-test-tq"
ALTERNATE_TASK_QUEUE = "activity-operator-test-tq-alt"
WORKFLOW_ACTIVITY_ID = "test-activity"
IDENTITY = "activity-operator-workload"

# Long enough that attempts are countable between polls, short enough that
# waiting for a few attempts is quick.
RETRY_INTERVAL = timedelta(seconds=2)
START_TO_CLOSE = timedelta(seconds=10)
ATTEMPTS_BEFORE_RESET = 3

FAIL = "fail"
HEARTBEAT_FAIL = "heartbeat-fail"
SUCCEED = "succeed"

RUN_TAG = uuid.uuid4().hex[:8]
_ids = itertools.count()


def unique(prefix: str) -> str:
    return f"{prefix}-{RUN_TAG}-{next(_ids)}"


# --------------------------------------------------------------------------- #
# Worker
# --------------------------------------------------------------------------- #

# What the Activity itself saw, keyed by Workflow ID for a workflow Activity and
# by Activity ID for a Standalone Activity: the task queue each attempt arrived
# on, and how many heartbeat details each attempt inherited from the previous
# one.
DISPATCH_QUEUES: dict[str, list[str]] = defaultdict(list)
INHERITED_HEARTBEATS: dict[str, list[int]] = defaultdict(list)


@activity.defn(name=ACTIVITY_TYPE)
async def operator_test_activity(mode: str) -> str:
    info = activity.info()
    key = info.workflow_id or info.activity_id
    DISPATCH_QUEUES[key].append(info.task_queue)
    if mode == HEARTBEAT_FAIL:
        INHERITED_HEARTBEATS[key].append(len(info.heartbeat_details))
        activity.heartbeat("checkpoint")
        await asyncio.sleep(0.2)
        raise ApplicationError("failing on purpose, after heartbeating")
    if mode == FAIL:
        raise ApplicationError("failing on purpose")
    return "done"


@workflow.defn(name=WORKFLOW_TYPE)
class OperatorTestWorkflow:
    @workflow.run
    async def run(self, mode: str) -> str:
        return await workflow.execute_activity(
            ACTIVITY_TYPE,
            mode,
            activity_id=WORKFLOW_ACTIVITY_ID,
            start_to_close_timeout=START_TO_CLOSE,
            retry_policy=RetryPolicy(
                initial_interval=RETRY_INTERVAL, maximum_interval=RETRY_INTERVAL
            ),
        )


