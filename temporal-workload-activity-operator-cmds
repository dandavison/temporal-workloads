class TestFn(Protocol):
    __name__: str

    def __call__(self, ctx: Ctx) -> Awaitable[None]: ...


@dataclass
class Test:
    group: str
    name: str
    fn: TestFn


TESTS: list[Test] = []


def test(group: str) -> Callable[[TestFn], TestFn]:
    def register(fn: TestFn) -> TestFn:
        TESTS.append(Test(group=group, name=fn.__name__.removeprefix("test_"), fn=fn))
        return fn

    return register


