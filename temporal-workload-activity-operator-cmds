    """--start-delay is documented as unsupported for workflow Activities, so it
    should be rejected. Accepting it is only defensible if it actually applies:
    reporting success while the stored options ignore the delay is not."""
    handle = await start_workflow_activity(ctx)
    res = await cli(
        ctx,
        "activity",
        "update-options",
        "--activity-id",
        WORKFLOW_ACTIVITY_ID,
        "--workflow-id",
        handle.id,
        "--start-delay",
        "30s",
    )
    if res.code != 0:
        return
    stored = (await wf_activity(ctx, handle)).activity_options
    assert_equal(
        stored.start_delay.ToTimedelta(),
        timedelta(seconds=30),
        f"start delay stored after update-options exited 0 and echoed "
        f"{res.json['StartDelay']}ns",
    )


