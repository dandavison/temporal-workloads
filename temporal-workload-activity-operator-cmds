SAA_PAUSE = "standalone activity: pause/unpause"


@test(SAA_PAUSE)
async def test_pause_unpause_latest_run(ctx: Ctx) -> None:
    """--activity-id alone targets the latest run."""
    handle = await start_standalone(ctx)

    await cli_ok(
        ctx,
        "activity",
        "pause",
        "--activity-id",
        handle.id,
        "--identity",
        IDENTITY,
        "--reason",
        "workload test",
    )
    await wait_until("activity to be paused", lambda: saa_paused(ctx, handle))

    await cli_ok(ctx, "activity", "unpause", "--activity-id", handle.id)
    await wait_until("activity to be unpaused", lambda: not_(saa_paused(ctx, handle)))


@test(SAA_PAUSE)
async def test_pause_unpause_explicit_run_id(ctx: Ctx) -> None:
    """--activity-id with --run-id targets that specific run."""
    handle = await start_standalone(ctx)

    await cli_ok(
        ctx, "activity", "pause", "--activity-id", handle.id, "--run-id", run_id(handle)
    )
    await wait_until("activity to be paused", lambda: saa_paused(ctx, handle))

    await cli_ok(
        ctx,
        "activity",
        "unpause",
        "--activity-id",
        handle.id,
        "--run-id",
        run_id(handle),
    )
    await wait_until("activity to be unpaused", lambda: not_(saa_paused(ctx, handle)))


@test(SAA_PAUSE)
async def test_pause_unknown_run_id_fails(ctx: Ctx) -> None:
    """A --run-id that does not exist is an error, not a silent fallback to the
    latest run."""
    handle = await start_standalone(ctx)
    await cli_fails(
        ctx,
        "activity",
        "pause",
        "--activity-id",
        handle.id,
        "--run-id",
        str(uuid.uuid4()),
    )
    assert_equal(
        await saa_paused(ctx, handle), False, "activity should still be running"
    )


@test(SAA_PAUSE)
async def test_unpause_reset_attempts(ctx: Ctx) -> None:
    """--reset-attempts zeroes the attempt count as the Activity resumes."""
    handle = await start_standalone(ctx, wait_for_attempt=ATTEMPTS_BEFORE_RESET)
    await cli_ok(ctx, "activity", "pause", "--activity-id", handle.id)
    await wait_until("activity to be paused", lambda: saa_paused(ctx, handle))

    await cli_ok(
        ctx, "activity", "unpause", "--activity-id", handle.id, "--reset-attempts"
    )
    await wait_until(
        "attempt count to drop",
        lambda: saa_attempt_below(ctx, handle, ATTEMPTS_BEFORE_RESET),
    )


@test(SAA_PAUSE)
async def test_unpause_reset_heartbeats(ctx: Ctx) -> None:
    """--reset-heartbeats clears the heartbeat details the next attempt would
    otherwise inherit."""
    handle = await start_standalone(ctx, HEARTBEAT_FAIL)
    await wait_until(
        "an attempt to inherit heartbeat details",
        lambda: inherited_heartbeats(handle.id, after=0),
    )
    attempts_so_far = len(INHERITED_HEARTBEATS[handle.id])

    await cli_ok(ctx, "activity", "pause", "--activity-id", handle.id)
    await wait_until("activity to be paused", lambda: saa_paused(ctx, handle))
    await cli_ok(
        ctx, "activity", "unpause", "--activity-id", handle.id, "--reset-heartbeats"
    )
    await wait_until(
        "the next attempt to inherit no heartbeat details",
        lambda: lost_heartbeats(handle.id, after=attempts_so_far),
    )


@test(SAA_PAUSE)
async def test_unpause_keeps_heartbeats_by_default(ctx: Ctx) -> None:
    """Without --reset-heartbeats, heartbeat details survive the pause."""
    handle = await start_standalone(ctx, HEARTBEAT_FAIL)
    await wait_until(
        "an attempt to inherit heartbeat details",
        lambda: inherited_heartbeats(handle.id, after=0),
    )
    attempts_so_far = len(INHERITED_HEARTBEATS[handle.id])

    await cli_ok(ctx, "activity", "pause", "--activity-id", handle.id)
    await wait_until("activity to be paused", lambda: saa_paused(ctx, handle))
    await cli_ok(ctx, "activity", "unpause", "--activity-id", handle.id)
    await wait_until(
        "a later attempt to still inherit heartbeat details",
        lambda: inherited_heartbeats(handle.id, after=attempts_so_far),
    )
    assert_equal(
        await lost_heartbeats(handle.id, after=attempts_so_far),
        False,
        "no attempt should have lost its heartbeat details",
    )


