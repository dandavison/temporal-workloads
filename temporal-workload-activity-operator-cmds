# --------------------------------------------------------------------------- #
# Runner
# --------------------------------------------------------------------------- #

# (command, flag, present) triples proving the CLI under test is the branch
# build rather than a released binary.
CLI_SURFACE: list[tuple[str, str, bool]] = [
    ("pause", "--workflow-id", True),
    ("pause", "--run-id", True),
    ("update-options", "--start-delay", True),
    ("unpause", "--reset-heartbeats", True),
    ("reset", "--reset-heartbeats", False),
]


def check_cli_surface(cfg: Config) -> None:
    for command, flag, present in CLI_SURFACE:
        help_text = subprocess.run(
            [cfg.cli, "activity", command, "--help"],
            capture_output=True,
            text=True,
            timeout=30,
            check=False,
        ).stdout
        if (flag in help_text) is not present:
            verb = "lacks" if present else "still has"
            sys.exit(
                f"{cfg.cli} activity {command} {verb} {flag}, so it is not the "
                "spk/activity-operator-cmds build. Build it in the cli repo with:\n"
                "  go build -o /tmp/temporal-activity-ops ./cmd/temporal\n"
                "and point TEMPORAL_CLI at it."
            )


async def run_tests(ctx: Ctx, tests: list[Test], timeout: float) -> list[str]:
    failures: list[str] = []
    group = ""
    for t in tests:
        if t.group != group:
            group = t.group
            print(f"\n=== {group} ===")
        started = time.monotonic()
        try:
            await asyncio.wait_for(t.fn(ctx), timeout=timeout)
            print(f"  PASS  {t.name} ({time.monotonic() - started:.1f}s)")
        except Exception as err:  # noqa: BLE001 - any failure is a test failure
            failures.append(f"{t.name}: {err}")
            print(f"  FAIL  {t.name} ({time.monotonic() - started:.1f}s)")
            print(f"        {err}")
        finally:
            for cleanup in reversed(ctx.cleanups):
                await cleanup()
            ctx.cleanups.clear()
    return failures


async def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--list", action="store_true", help="list tests and exit")
    parser.add_argument("--filter", default="", help="run tests matching a substring")
    parser.add_argument(
        "--test-timeout", type=float, default=180.0, help="per-test timeout in seconds"
    )
    parser.add_argument(
        "-v", "--verbose", action="store_true", help="echo every CLI command"
    )
    args = parser.parse_args()

    tests = [t for t in TESTS if args.filter in t.name or args.filter in t.group]
    if args.list:
        for t in tests:
            print(f"{t.group}: {t.name}")
        return 0
    if not tests:
        print(f"no tests match {args.filter!r}")
        return 1

    cfg = Config.from_args(args)
    check_cli_surface(cfg)
    print(f"CLI: {cfg.cli}")
    print(f"Server: {cfg.address} namespace={cfg.namespace}")
    print(f"Running {len(tests)} test(s), run tag {RUN_TAG}")

    # The Activities under test fail on purpose, and cleanup terminates them
    # mid-attempt; the resulting stack traces and core warnings would bury the
    # results.
    logging.disable(logging.CRITICAL)
    runtime = Runtime(
        telemetry=TelemetryConfig(
            logging=LoggingConfig(
                filter=TelemetryFilter(core_level="ERROR", other_level="ERROR")
            )
        )
    )

    try:
        client = await Client.connect(
            cfg.address,
            namespace=cfg.namespace,
            api_key=cfg.api_key,
            tls=bool(cfg.api_key),
            identity=IDENTITY,
            runtime=runtime,
        )
    except RuntimeError as err:
        sys.exit(f"cannot reach a Temporal server at {cfg.address}: {err}")
    primary = Worker(
        client,
        task_queue=PRIMARY_TASK_QUEUE,
        workflows=[OperatorTestWorkflow],
        activities=[operator_test_activity],
        workflow_runner=UnsandboxedWorkflowRunner(),
    )
    alternate = Worker(
        client,
        task_queue=ALTERNATE_TASK_QUEUE,
        activities=[operator_test_activity],
    )

    async with primary, alternate:
        failures = await run_tests(Ctx(cfg, client), tests, args.test_timeout)

    print(f"\n{len(tests) - len(failures)}/{len(tests)} passed")
    for failure in failures:
        print(f"  FAIL  {failure}")
    return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(asyncio.run(main()))
    except KeyboardInterrupt:
        sys.exit(130)
