async def start_standalone(
    ctx: Ctx,
    mode: str = FAIL,
    *,
    task_queue: str = PRIMARY_TASK_QUEUE,
    start_delay: timedelta | None = None,
    wait_for_attempt: int = 1,
) -> ActivityHandle:
    """Start a Standalone Activity. In the default FAIL mode it retries forever,
    so it stays pending and can be paused, reset and updated."""
    handle = await ctx.client.start_activity(
        ACTIVITY_TYPE,
        mode,
        id=unique("saa"),
        task_queue=task_queue,
        start_to_close_timeout=START_TO_CLOSE,
        retry_policy=RetryPolicy(
            initial_interval=RETRY_INTERVAL, maximum_interval=RETRY_INTERVAL
        ),
        start_delay=start_delay,
        result_type=str,
    )
    ctx.cleanups.append(lambda: terminate_activity(handle))
    if wait_for_attempt:
        await wait_until(
            f"standalone activity {handle.id} to reach attempt {wait_for_attempt}",
            lambda: saa_attempt_at_least(ctx, handle, wait_for_attempt),
        )
    return handle


async def start_workflow_activity(
    ctx: Ctx, mode: str = FAIL, *, wait_for_attempt: int = 1
) -> WorkflowHandle[Any, str]:
    """Start a Workflow whose single Activity retries forever."""
    handle = await ctx.client.start_workflow(
        WORKFLOW_TYPE,
        mode,
        id=unique("wf"),
        task_queue=PRIMARY_TASK_QUEUE,
        result_type=str,
    )
    ctx.cleanups.append(lambda: terminate_workflow(handle))
    await wait_until(
        f"workflow {handle.id} activity to reach attempt {wait_for_attempt}",
        lambda: wf_attempt_at_least(ctx, handle, wait_for_attempt),
    )
    return handle


async def terminate_activity(handle: ActivityHandle) -> None:
    # Already closed (e.g. the Activity completed during its own test).
    with contextlib.suppress(RPCError):
        await handle.terminate(reason="workload cleanup")


async def terminate_workflow(handle: WorkflowHandle[Any, Any]) -> None:
    with contextlib.suppress(RPCError):
        await handle.terminate(reason="workload cleanup")


def run_id(handle: ActivityHandle) -> str:
    """The Run ID of a started Activity, which is always set."""
    assert handle.run_id is not None
    return handle.run_id


async def saa_info(ctx: Ctx, handle: ActivityHandle) -> ActivityExecutionInfo:
    resp = await ctx.client.workflow_service.describe_activity_execution(
        DescribeActivityExecutionRequest(
            namespace=ctx.cfg.namespace, activity_id=handle.id, run_id=run_id(handle)
        )
    )
    return resp.info


async def wf_activity(
    ctx: Ctx, handle: WorkflowHandle[Any, Any]
) -> PendingActivityInfo:
    resp = await ctx.client.workflow_service.describe_workflow_execution(
        DescribeWorkflowExecutionRequest(
            namespace=ctx.cfg.namespace,
            execution=WorkflowExecution(workflow_id=handle.id),
        )
    )
    for pending in resp.pending_activities:
        if pending.activity_id == WORKFLOW_ACTIVITY_ID:
            return pending
    raise AssertionError(
        f"workflow {handle.id} has no pending activity {WORKFLOW_ACTIVITY_ID}"
    )


async def wait_visible(ctx: Ctx, query: str, count: int) -> None:
    async def indexed() -> bool:
        found = 0
        async for _ in ctx.client.list_workflows(query):
            found += 1
        return found >= count

    await wait_until(
        f"visibility to index {count} workflow(s) for {query}", indexed, 60
    )


def workflow_id_query(handles: list[WorkflowHandle[Any, str]]) -> str:
    ors = " OR ".join(f'WorkflowId="{handle.id}"' for handle in handles)
    return f"({ors}) AND ExecutionStatus='Running'"


# --------------------------------------------------------------------------- #
# Predicates, for wait_until and one-shot assertions
# --------------------------------------------------------------------------- #


async def not_(awaitable: Awaitable[bool]) -> bool:
    return not await awaitable


async def saa_attempt_at_least(ctx: Ctx, handle: ActivityHandle, attempt: int) -> bool:
    return (await saa_info(ctx, handle)).attempt >= attempt


async def saa_attempt_below(ctx: Ctx, handle: ActivityHandle, attempt: int) -> bool:
    return (await saa_info(ctx, handle)).attempt < attempt


async def saa_paused(ctx: Ctx, handle: ActivityHandle) -> bool:
    return (await saa_info(ctx, handle)).run_state == (
        PendingActivityState.PENDING_ACTIVITY_STATE_PAUSED
    )


async def saa_completed(ctx: Ctx, handle: ActivityHandle) -> bool:
    return (await saa_info(ctx, handle)).status == (
        ActivityExecutionStatus.ACTIVITY_EXECUTION_STATUS_COMPLETED
    )


async def saa_start_to_close_is(
    ctx: Ctx, handle: ActivityHandle, expected: timedelta
) -> bool:
    return (
        await saa_info(ctx, handle)
    ).start_to_close_timeout.ToTimedelta() == expected


async def wf_attempt_at_least(
    ctx: Ctx, handle: WorkflowHandle[Any, Any], attempt: int
) -> bool:
    try:
        return (await wf_activity(ctx, handle)).attempt >= attempt
    except AssertionError:
        return False


async def wf_attempt_below(
    ctx: Ctx, handle: WorkflowHandle[Any, Any], attempt: int
) -> bool:
    return (await wf_activity(ctx, handle)).attempt < attempt


async def wf_paused(ctx: Ctx, handle: WorkflowHandle[Any, Any]) -> bool:
    return (await wf_activity(ctx, handle)).paused


async def wf_task_queue_is(
    ctx: Ctx, handle: WorkflowHandle[Any, Any], expected: str
) -> bool:
    return (await wf_activity(ctx, handle)).activity_options.task_queue.name == expected


async def wf_start_to_close_is(
    ctx: Ctx, handle: WorkflowHandle[Any, Any], expected: timedelta
) -> bool:
    options = (await wf_activity(ctx, handle)).activity_options
    return options.start_to_close_timeout.ToTimedelta() == expected


async def dispatched_on(key: str, task_queue: str) -> bool:
    return task_queue in DISPATCH_QUEUES[key]


async def inherited_heartbeats(key: str, *, after: int) -> bool:
    """An attempt started after `after` earlier attempts saw heartbeat details."""
    return any(count > 0 for count in INHERITED_HEARTBEATS[key][after:])


async def lost_heartbeats(key: str, *, after: int) -> bool:
    """An attempt started after `after` earlier attempts saw no heartbeat
    details, i.e. they were cleared."""
    return any(count == 0 for count in INHERITED_HEARTBEATS[key][after:])


